@model PortalModel
@{var p=Model.Producto;}
<div class="intro"><div class="eyebrow">ADMINISTRACIÓN</div><h1>@Model.Titulo</h1><p>Actualizá la información, disponibilidad y fotos del material.</p></div>
<section class="panel product-editor"><form method="post" enctype="multipart/form-data" action="/EditarProducto?id=@p.Id">@Html.AntiForgeryToken()
<div class="grid2">
<label>Producto<input name="nombre" value="@p.Nombre" maxlength="250" required></label>
<label>Marca<input name="marca" value="@p.Marca.Nombre" maxlength="120" required></label>
<label>Código de catálogo<input name="codigo" value="@p.CodigoCatalogo" maxlength="160"></label>
<label>Código del local (opcional)<input name="local" value="@p.CodigoLocal" maxlength="160"></label>
<label>Tipo<input name="tipo" value="@p.Tipo" maxlength="120" required></label>
<label>Familia / categoría<input name="categoria" value="@p.Categoria.Nombre" maxlength="120"></label>
<label>Unidad (unidad, m, rollo...)<input name="unidad" value="@p.Unidad" maxlength="30" required></label>
</div>
<label>Descripción<textarea name="descripcion" maxlength="1500" rows="3">@p.Descripcion</textarea></label>
<fieldset class="image-editor"><legend>Fotos del producto</legend>
@if(p.Fotos.Count==0){<div class="product-gallery-empty">Este producto todavía no tiene fotos.</div>}else{<div class="product-gallery">@foreach(var foto in p.Fotos.OrderByDescending(x=>x.EsPrincipal).ThenBy(x=>x.Orden)){<article class="product-gallery-item"><img class="product-image-preview" src="~/uploads/productos/@foto.NombreArchivo" alt="Foto de @p.Nombre"><label class="gallery-primary"><input type="radio" name="fotoPrincipal" value="@foto.Id" checked="@foto.EsPrincipal">Foto principal</label><label class="check gallery-remove"><input type="checkbox" name="quitarFotos" value="@foto.Id">Desvincular</label></article>}</div>}
<div class="image-upload"><label>Agregar fotos<input name="imagenes" type="file" accept="image/jpeg,image/png,image/webp" multiple></label><small>JPG, PNG o WebP. Máximo 5 MB por archivo, 8 archivos por carga y 12 fotos asociadas por producto. Desvincular no elimina el archivo físico.</small></div></fieldset>
<label class="check"><input type="checkbox" name="activo" value="1" checked="@p.Activo">Disponible en el catálogo</label>
<div class="actions"><button class="primary">Guardar producto</button><a href="/Catalogo">Volver</a></div>
</form></section>
