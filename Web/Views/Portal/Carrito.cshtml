@model PortalModel
@{var p=Model.Presupuesto;}
<div class="intro"><div class="eyebrow">PRESUPUESTO EN PREPARACIÓN</div><h1>Revisar presupuesto</h1><p>Verificá los materiales y las cantidades antes de generar la orden.</p></div>
@if(p.Items.Count==0){
<section class="panel empty-cart"><div class="empty-cart-icon" aria-hidden="true">🛒</div><h2>Tu carrito está vacío</h2><p>Agregá materiales desde el catálogo para comenzar el presupuesto.</p><a class="button primary" href="/Catalogo">Explorar catálogo</a></section>
}else{
<div class="cart-layout"><section class="cart-main">
<section class="panel work-name"><form method="post" action="/Carrito">@Html.AntiForgeryToken()<label>Nombre de obra<input name="nombre" value="@p.Nombre" maxlength="160" required></label><button class="button" name="accion" value="nombre">Guardar nombre</button></form></section>
<div class="cart-items">
@foreach(var item in p.Items){<article class="cart-item">@if(string.IsNullOrEmpty(item.Imagen)){<span class="cart-item-image product-image-placeholder">Sin imagen</span>}else{<img class="cart-item-image" src="~/uploads/productos/@item.Imagen" alt="Imagen de @item.Nombre">}<div class="cart-item-info"><h2>@item.Nombre</h2><small>@(string.IsNullOrEmpty(item.CodigoCatalogo)?"Sin código":item.CodigoCatalogo) · @item.Marca</small>@if(!string.IsNullOrWhiteSpace(item.ColorNombre)){<span class="color-badge" data-color="@item.ColorNombre"><span aria-hidden="true"></span>@item.ColorNombre</span>}<p>@item.Descripcion</p></div><form class="cart-quantity" method="post" action="/Carrito">@Html.AntiForgeryToken()<input type="hidden" name="producto" value="@item.ProductoId"><input type="hidden" name="color" value="@item.ColorId"><label><span>Cantidad</span><input type="number" name="cantidad" value="@PortalModel.Numero(item.Cantidad)" min="0.001" max="1000000" step="0.001" required></label><button name="accion" value="cantidad">Actualizar</button><button class="dangertext" name="accion" value="quitar">Quitar</button></form></article>}
</div>
<div class="cart-secondary"><a class="button" href="/Catalogo">+ Seguir agregando productos</a><form method="post" action="/Carrito">@Html.AntiForgeryToken()<button class="dangertext" name="accion" value="vaciar">Vaciar carrito</button></form></div>
</section><aside class="panel cart-summary"><h2>Resumen</h2><strong>@p.Items.Count @(p.Items.Count==1?"producto":"productos")</strong><p class="muted">Revisá los materiales y sus cantidades antes de continuar.</p><form method="post" action="/Carrito">@Html.AntiForgeryToken()<button class="primary cart-confirm" name="accion" value="confirmar">Confirmar y generar orden</button></form><small>Después de confirmar podrás descargar el PDF.</small></aside></div>
}
