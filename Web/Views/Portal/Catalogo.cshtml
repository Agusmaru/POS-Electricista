@model PortalModel
<div class="intro"><div class="eyebrow">MATERIALES ELÉCTRICOS</div><h1>Catálogo</h1><p>Encontrá los materiales para tu próxima obra. Los precios publicados son orientativos.</p></div>
<div class="toolbar"><span class="count">@Model.Total materiales</span><div class="catalog-toolbar"><div class="view-switch" aria-label="Modo de visualización"><a class="button @(Model.Vista=="lista"?"active":"")" aria-current="@(Model.Vista=="lista"?"true":null)" href="@Url.Action("Catalogo",new {q=Model.Q,marca=Model.Marca,tipo=Model.Tipo,inactivos=Model.Inactivos,vista="lista"})">☷ Lista</a><a class="button @(Model.Vista=="tarjetas"?"active":"")" aria-current="@(Model.Vista=="tarjetas"?"true":null)" href="@Url.Action("Catalogo",new {q=Model.Q,marca=Model.Marca,tipo=Model.Tipo,inactivos=Model.Inactivos,vista="tarjetas"})">▦ Tarjetas</a></div><a class="button primary" href="/Carrito"><span>Ver carrito</span><span class="cart-badge @(Model.CarritoCantidad == 0 ? "is-empty" : "")" data-cart-count aria-label="@Model.CarritoCantidad productos en el carrito">@Model.CarritoCantidad</span></a></div></div>
<form class="filters" method="get" action="/Catalogo"><input type="hidden" name="vista" value="@Model.Vista">
<label>Producto, descripción o código<input name="q" value="@Model.Q" maxlength="250"></label>
<label>Marca<select name="marca"><option value="">Todos</option>@foreach(var marca in Model.Marcas) { <option value="@marca" selected="@(marca == Model.Marca)">@marca</option> }</select></label>
<label>Tipo<select name="tipo"><option value="">Todos</option>@foreach(var tipo in Model.Tipos) { <option value="@tipo" selected="@(tipo == Model.Tipo)">@tipo</option> }</select></label>
@if(Model.Usuario.Admin) { <label>Estado<select name="inactivos"><option value="false">Activos</option><option value="true" selected="@Model.Inactivos">Todos</option></select></label> }
<button class="primary">Buscar</button><a href="/Catalogo">Limpiar</a></form>
<section id="catalog-results" aria-label="Resultados del catálogo"><div id="catalog-feedback" class="catalog-feedback" role="status" aria-live="polite" hidden></div>
<div class="tablewrap catalog-table catalog-mode-@Model.Vista"><table aria-label="Catálogo de materiales"><thead><tr><th scope="col">Producto</th><th scope="col">Código</th><th scope="col">Marca</th><th scope="col">Descripción</th><th scope="col">Imágenes</th><th scope="col" class="right">Precio</th><th scope="col"><span class="sr-only">Acciones</span></th></tr></thead><tbody>
@foreach(var a in Model.Productos) {
<tr><td class="product-name"><strong>@a.Nombre</strong>@if(!a.Activo){<span class="tag">Inactivo</span>}</td><td class="codes" data-label="Código">@(string.IsNullOrEmpty(a.CodigoCatalogo)?"Sin código":a.CodigoCatalogo)<small class="catalog-code-extra">Local: @(string.IsNullOrEmpty(a.CodigoLocal)?"A consultar":a.CodigoLocal)</small></td><td data-label="Marca">@a.Marca.Nombre<small class="catalog-brand-extra">@a.Tipo</small></td><td class="product-description" data-label="Descripción">@a.Descripcion<small class="catalog-description-extra">Unidad: @a.Unidad</small></td><td class="product-image-cell" data-label="Imagen">@if(string.IsNullOrEmpty(a.Imagen)){<span class="product-image-placeholder" aria-label="Producto sin imagen">Sin imagen</span>}else{<img class="product-image" src="~/uploads/productos/@a.Imagen" alt="Imagen de @a.Nombre" loading="lazy">}</td><td class="right catalog-price" data-label="Precio">@PortalModel.Precio(a.PrecioEstimado)</td><td class="catalog-actions">@if(a.Activo){<form class="catalog-add" method="post" action="/Carrito/Agregar">@Html.AntiForgeryToken()<input type="hidden" name="producto" value="@a.Id"><input type="hidden" name="volver" value="@(Context.Request.Path+Context.Request.QueryString)"><input aria-label="Cantidad de @a.Nombre" type="number" name="cantidad" value="1" min="0.001" max="1000000" step="0.001" required><button class="primary" name="accion" value="agregar">+ Agregar</button></form>}@if(Model.Usuario.Admin){<a class="button edit-product" href="/EditarProducto?id=@a.Id">Editar</a>}</td></tr>
}
@if(Model.Total == 0){<tr><td colspan="6">No hay productos con estos filtros.</td></tr>}
</tbody></table></div>
<div class="pagination">Página @Model.Pagina de @Model.Paginas
@if(Model.Pagina>1){<a href="@Url.Action("Catalogo",new {q=Model.Q,marca=Model.Marca,tipo=Model.Tipo,inactivos=Model.Inactivos,vista=Model.Vista,pagina=Model.Pagina-1})">Anterior</a>}
@if(Model.Pagina<Model.Paginas){<a href="@Url.Action("Catalogo",new {q=Model.Q,marca=Model.Marca,tipo=Model.Tipo,inactivos=Model.Inactivos,vista=Model.Vista,pagina=Model.Pagina+1})">Siguiente</a>}
</div></section>
